# LibreChat + RAG adapter — example env (no real secrets)
# Copy to .env next to librechat.yaml / docker-compose and fill values.

# --- Host / app ---
HOST=0.0.0.0
PORT=3080
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
NO_INDEX=true
ALLOW_REGISTRATION=false
ALLOW_EMAIL_LOGIN=false
ALLOW_UNSAFE_DOCKER=false

# --- Mongo (LibreChat conversation history) ---
# Spike: local mongo:// or Atlas / Cosmos connection string.
MONGO_URI=mongodb://host.docker.internal:27017/LibreChat

# --- Entra OIDC (tenant lock + app-role gate) ---
OPENID_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_SESSION_SECRET=
OPENID_SCOPE=openid profile email offline_access
OPENID_BUTTON_LABEL=Zaloguj kontem firmowym
# Require Entra app role / group claim (exact name depends on LibreChat version).
OPENID_REQUIRED_ROLE=Northwind.AI.User
OPENID_REUSE_TOKENS=true

# --- SharePoint / OneDrive file picker (OBO) ---
ENABLE_SHAREPOINT_FILEPICKER=true
# Delegated Graph scopes on the Entra app: Files.Read.All, AllSites.Read, access_as_user
SHAREPOINT_BASE_URL=

# --- RAG adapter (OpenAI-compatible custom endpoint) ---
# Must match teams-bot RAG_WEB_API_KEY and librechat.yaml Authorization / apiKey.
RAG_WEB_API_KEY=change-me-local-only
# baseURL is in librechat.yaml (http://host.docker.internal:8081/v1)

# --- Branding / locale (optional) ---
APP_TITLE=Northwind Assistant
HELP_AND_FAQ_URL=
