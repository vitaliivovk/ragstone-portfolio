# RAGStone — copy to .env and fill in secrets

# ============================================
# API KEYS
# ============================================
OPENAI_API_KEY=your_openai_api_key
PINECONE_API_KEY=your_pinecone_api_key

# ============================================
# OPENAI (chat + bot embeddings; must match index dims)
# ============================================
OPENAI_MODEL=gpt-5-mini
OPENAI_OPTIMIZER_MODEL=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: HISTORY_MESSAGE_LIMIT=10  HISTORY_CACHE_TTL_SECONDS=30  MAX_RAG_CONTEXT_CHARS=48000
# RAG_HANDBOOK_DIRECT_ENABLED=0      # 0 = default: full Pinecone RAG; 1 = legacy inlined Instrukcja without search
# RAG_ANCHOR_RETRIEVAL_ENABLED=1   # 0 = off; parallel semantic fetch from fixed handbook paths then merge with scoped retrieval
# RAG_ANCHOR_CHUNK_K=6               # top-k chunks across the anchor paths (single Pinecone query per turn)
# RAG_ANCHOR_SOURCE_RELATIVE_PATHS=  # optional comma-separated sourceRelativePath values (under source_data/) overriding defaults
# RAG_INLINE_SAME_DOC_CITATION_COLLAPSE_ENABLED=1  # collapse [Źródło 1], [Źródło 2], … to one when same file; 0 = off

# ============================================
# PINECONE
# ============================================
# Index name (pipeline + bot). Legacy alias: PINECONE_INDEX (e.g. Terraform on Azure).
PINECONE_INDEX_NAME=text-embedding-3-small

# Indexer: upsert to both (defaults v3 + production if unset)
PINECONE_NAMESPACE_DEV=v3
PINECONE_NAMESPACE_PROD=production

# Bot query target (dev app → v3, prod app → production)
# PINECONE_NAMESPACE=v3
# SUMMARY_RETRIEVAL_ENABLED=0   # default in bot code when unset; set 1 for summary-first retrieval

# Optional: PINECONE_NAMESPACES=v3,production  PINECONE_CLOUD  PINECONE_REGION

# ============================================
# PIPELINE (pinecone-pipeline / ragstone-index)
# ============================================
# DOCS_DIR=   CHUNK_OUTPUT_DIR=
SEND_TO_PINECONE=0
# CACHE_EMBEDDINGS_TO_DISK=1
# With SEND_TO_PINECONE=1, span summaries are ON by default (summaries=true vectors; SUMMARY_MODEL chat per span).
# Opt out: GENERATE_SUMMARIES=0
# SUMMARY_MODEL=gpt-5-nano
# SUMMARY_PARALLELISM=4

# ============================================
# SHAREPOINT (optional citations)
# ============================================
# Indexer (pinecone-pipeline): optional full library folder URL so chunks get sharepointUrl metadata.
# SHAREPOINT_BASE_URL=https://contoso.sharepoint.com/sites/Northwind-AI/Shared%20Documents/AI/dev
# Teams bot: base URL for citation links when vectors only have sourceRelativePath (must mirror source_data layout).
# SHAREPOINT_LIBRARY_BASE_URL=https://contoso.sharepoint.com/sites/Northwind-AI/Shared%20Documents/AI/dev
# Bot also accepts SHAREPOINT_BASE_URL alone if LIBRARY is unset (same folder URL as the indexer).

# ============================================
# TEAMS BOT
# ============================================
MICROSOFT_APP_ID=your_app_id
MICROSOFT_APP_PASSWORD=your_app_password
MICROSOFT_APP_TYPE=SingleTenant
# MICROSOFT_APP_TENANT_ID=

# Conversation memory (local: optional; Azure: often AzureWebJobsStorage)
# AZURE_STORAGE_CONNECTION_STRING=

# ============================================
# TERRAFORM + Azure CLI (tenant/subscription per environment)
# ============================================
# scripts/terraform.sh and deploy-*.sh pick vars by first argument (dev|prod):
#   dev  → DEV_AZURE_* if set, else legacy AZURE_* (dev-only fallback)
#   prod → PROD_AZURE_* only
# They are exported as TF_VAR_tenant_id / TF_VAR_subscription_id. The committed
# environments/<env>.tfvars intentionally omit these IDs, so Terraform needs them from here
# (or from TF_VAR_tenant_id / TF_VAR_subscription_id exported in your shell).

DEV_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
DEV_AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

PROD_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
PROD_AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Legacy (optional): if DEV_* are unset, dev commands still read these.
# AZURE_TENANT_ID=
# AZURE_SUBSCRIPTION_ID=

# Alternative without .env:
# export TF_VAR_tenant_id=00000000-0000-0000-0000-000000000000
# export TF_VAR_subscription_id=00000000-0000-0000-0000-000000000000

# Region for prod is in infrastructure/environments/prod.tfvars (e.g. polandcentral).
