traces | where timestamp > ago(45m) | where message contains "RAG_TURN_AUDIT" or message contains "OPTIMIZER" or message contains "direct_mode" or message contains "needs_rag" or message contains "respond_direct" or message contains "respond_with_rag" or message contains "handbook" or message contains "coercing" | project timestamp, severityLevel, message, operation_Name | order by timestamp desc | take 120
