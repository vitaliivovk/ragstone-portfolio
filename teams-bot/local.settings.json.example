{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "MICROSOFT_APP_ID": "your-bot-app-id",
    "MICROSOFT_APP_PASSWORD": "your-bot-app-password",
    "MICROSOFT_APP_TYPE": "SingleTenant",
    "MICROSOFT_APP_TENANT_ID": "your-azure-tenant-id",
    "OPENAI_API_KEY": "sk-your-openai-key",
    "OPENAI_MODEL": "gpt-5-mini",
    "OPENAI_OPTIMIZER_MODEL": "gpt-5-nano",
    "OPENAI_EMBEDDING_MODEL": "text-embedding-3-small",
    "OPENAI_MAX_COMPLETION_TOKENS": "32768",
    "PINECONE_API_KEY": "your-pinecone-key",
    "PINECONE_INDEX_NAME": "text-embedding-3-small",
    "PINECONE_NAMESPACE": "v3",
    "SUMMARY_RETRIEVAL_ENABLED": "0",
    "RAG_ANCHOR_RETRIEVAL_ENABLED": "1",
    "RAG_HANDBOOK_DIRECT_ENABLED": "0",
    "RAG_ANCHOR_CHUNK_K": "6",
    "SHAREPOINT_LIBRARY_BASE_URL": "https://contoso.sharepoint.com/sites/Northwind-AI/Shared%20Documents/AI/dev",
    "HISTORY_MESSAGE_LIMIT": "50",
    "HISTORY_TTL_HOURS": "24",
    "CONTEXT_CACHE_TTL_HOURS": "6",
    "USER_PREFERENCES_MAX_CHARS": "2000",
    "RAG_WEB_API_KEY": "change-me-local-web-adapter",
    "RAG_WEB_HOST": "127.0.0.1",
    "RAG_WEB_PORT": "8081"
  },
  "_comments": {
    "AzureWebJobsStorage": "Also used for conversation memory (Azure Table Storage). Use 'UseDevelopmentStorage=true' for local Azurite, or a real connection string for production.",
    "OPENAI_MODEL": "Model for chat completion (answers)",
    "OPENAI_OPTIMIZER_MODEL": "Cheaper model for RAG optimizer structured output",
    "SUMMARY_RETRIEVAL_ENABLED": "0 = chunk-only (default); 1 = summary-first Pinecone stage when summaries exist",
    "RAG_ANCHOR_RETRIEVAL_ENABLED": "1 = merge parallel semantic hits from fixed Instrukcje handbook paths into every RAG turn; 0 = off",
    "RAG_HANDBOOK_DIRECT_ENABLED": "0 = default: always full RAG (Instrukcja via Pinecone + anchor). 1 = legacy handbook direct path without search",
    "OPENAI_EMBEDDING_MODEL": "Model for embeddings (must match Pinecone index)",
    "OPENAI_MAX_COMPLETION_TOKENS": "Max completion tokens for the answer model (default 32768; raise if answers still hit length limit)",
    "HISTORY_MESSAGE_LIMIT": "Max conversation messages loaded per turn (default 50)",
    "HISTORY_TTL_HOURS": "Purge conversation Table rows older than this many hours (0 = disable hourly purge)",
    "CONTEXT_CACHE_TTL_HOURS": "Purge conversation_context cache rows older than this many hours (0 = disable)",
    "USER_PREFERENCES_MAX_CHARS": "Max length for /style preference text stored in Azure Table (default 2000)",
    "SHAREPOINT_LIBRARY_BASE_URL": "SharePoint folder mirroring source_data/ for citation links from Pinecone sourceRelativePath; if unset, SHAREPOINT_BASE_URL (same as indexer) is used",
    "RAG_WEB_API_KEY": "Bearer key for LibreChat → OpenAI-compat adapter (python -m web.app). Same value as librechat/.env RAG_WEB_API_KEY",
    "RAG_WEB_HOST": "Bind host for web adapter (default 127.0.0.1)",
    "RAG_WEB_PORT": "Bind port for web adapter (default 8081)"
  }
}
